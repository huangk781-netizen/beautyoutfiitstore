# 本機開發不一定需要建立 .env（沒有的話會用程式碼裡安全的開發用預設值）。
# 正式上線時，把這份檔案複製成 .env 並填入真實的值（或直接在 PaaS 平台的環境變數頁面設定，不一定要用 .env 檔案）。
# .env 不要提交進版本控制（已加入 .gitignore）。

# Django
SECRET_KEY=請換成一組隨機產生的長字串
DEBUG=False
ALLOWED_HOSTS=your-app.up.railway.app,yourdomain.com
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app,https://yourdomain.com

# 付款方式：目前只開放貨到付款；日後恢復銀行轉帳時再改為 True。
ENABLE_BANK_TRANSFER=False

# 資料庫：留空則用 SQLite（開發用）。正式環境設定 MySQL 連線字串，格式：
# mysql://使用者名稱:密碼@主機:3306/資料庫名稱
# Railway MySQL 若提供 MYSQL_URL，也可直接設定 MYSQL_URL；程式會自動讀取。
DATABASE_URL=mysql://user:password@host:3306/clothing_store

# Email：留空則用 console backend（開發用，信件只會印在終端機，不會真的寄出）。
# 要接 SendGrid 等 SMTP 服務時打開下面幾行：
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=你的-SendGrid-API-Key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=service@yourdomain.com
